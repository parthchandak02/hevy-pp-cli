      "description": "Update an existing workout. Required: workoutId. Optional: workout. Returns array of WorkoutsPutV1WorkoutidItem.",
      "method": "PUT",
      "path": "/v1/workouts/{workoutId}",
      "params": [
        {
          "name": "workoutId",
          "type": "string",
          "location": "path",
          "description": "The id of the workout",
          "required": true
        },
        {
          "name": "workout-description",
          "wire_name": "workout.description",
          "type": "string",
          "location": "body",
          "description": "A description for the workout workout."
        },
        {
          "name": "workout-end-time",
          "wire_name": "workout.end_time",
          "type": "string",
          "location": "body",
          "description": "The time the workout ended."
        },
        {
          "name": "workout-exercises",
          "wire_name": "workout.exercises",
          "type": "array",
          "location": "body",
          "description": "Exercises"
        },
        {
          "name": "workout-is-private",
          "wire_name": "workout.is_private",
          "type": "bool",
          "location": "body",
