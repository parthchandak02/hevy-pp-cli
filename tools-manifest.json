        },
        {
          "name": "workout-start-time",
          "wire_name": "workout.start_time",
          "type": "string",
          "location": "body",
          "description": "The time the workout started."
        },
        {
          "name": "workout-title",
          "wire_name": "workout.title",
          "type": "string",
