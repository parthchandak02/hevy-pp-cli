{
  "api_name": "hevy",
  "base_url": "https://api.hevyapp.com",
  "description": "Welcome to Hevy's public API! We're just starting to roll this out and depending on your\n      feedback, we'll be adding more features and endpoints. Also, we make no guarantees that \n      we won't completely change the structure or abandon the project entirely so use it at\n      your own risk. Currently, this API is only available to Hevy Pro users. You can get your \n      key on our web app at https://hevy.com/settings?developer. If you have any questions,\n      please reach out to pedro@hevyapp.com 🤝.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "api_key",
    "header": "api-key",
    "in": "header",
    "env_vars": [
      "HEVY_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "HEVY_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "body-measurements_get-v1",
      "description": "Get a paginated list of body measurements for the authenticated user. Optional: page (default: 1), pageSize (default: 10). Returns array of BodyMeasurement.",
      "method": "GET",
      "path": "/v1/body_measurements",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number (Must be 1 or greater)"
        },
        {
          "name": "pageSize",
          "type": "int",
          "location": "query",
          "description": "Number of items per page (Max 10)"
        }
      ]
    },
    {
      "name": "body-measurements_get-v1-date",
      "description": "Get a single body measurement by date. Required: date. Returns the BodyMeasurement.",
      "method": "GET",
      "path": "/v1/body_measurements/{date}",
      "params": [
        {
          "name": "date",
          "type": "string",
          "location": "path",
          "description": "The date of the body measurement (YYYY-MM-DD)",
          "required": true
        }
      ]
    },
    {
      "name": "body-measurements_post-v1",
      "description": "Create a body measurement entry for a given date. Returns 409 if an entry already exists for that date. Required: date. Optional: abdomen, chest_cm, fat_percent (plus 14 more).",
      "method": "POST",
      "path": "/v1/body_measurements",
      "params": [
        {
          "name": "abdomen",
          "type": "float",
          "location": "body",
