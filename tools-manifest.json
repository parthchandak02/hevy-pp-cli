        },
        {
          "name": "neck_cm",
          "type": "float",
          "location": "body",
          "description": "Neck cm"
        },
        {
          "name": "right_bicep_cm",
          "type": "float",
          "location": "body",
          "description": "Right bicep cm"
        },
        {
          "name": "right_calf",
          "type": "float",
          "location": "body",
          "description": "Right calf"
        },
        {
          "name": "right_forearm_cm",
          "type": "float",
          "location": "body",
          "description": "Right forearm cm"
        },
        {
          "name": "right_thigh",
          "type": "float",
          "location": "body",
          "description": "Right thigh"
        },
