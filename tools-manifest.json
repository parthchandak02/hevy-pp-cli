    {
      "name": "exercise-history_get-v1-exercisetemplateid",
      "description": "Get exercise history for a specific exercise template. Required: exerciseTemplateId. Optional: start_date, end_date. Returns array of ExerciseHistoryEntry.",
      "method": "GET",
      "path": "/v1/exercise_history/{exerciseTemplateId}",
      "params": [
        {
          "name": "exerciseTemplateId",
          "type": "string",
          "location": "path",
          "description": "The id of the exercise template",
          "required": true
        },
        {
          "name": "start_date",
          "type": "string",
          "location": "query",
          "description": "Optional start date for filtering exercise history (ISO 8601 format)"
        },
        {
          "name": "end_date",
          "type": "string",
          "location": "query",
          "description": "Optional end date for filtering exercise history (ISO 8601 format)"
        }
      ]
    },
    {
      "name": "exercise-templates_get-v1",
      "description": "Get a paginated list of exercise templates available on the account. Optional: page (default: 1), pageSize (default: 5). Returns array of ExerciseTemplate.",
      "method": "GET",
      "path": "/v1/exercise_templates",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number (Must be 1 or greater)"
        },
        {
          "name": "pageSize",
          "type": "int",
          "location": "query",
          "description": "Number of items on the requested page (Max 100)"
        }
      ]
    },
    {
      "name": "exercise-templates_get-v1-exercisetemplateid",
      "description": "Get a single exercise template by id. Required: exerciseTemplateId. Returns array of string.",
      "method": "GET",
      "path": "/v1/exercise_templates/{exerciseTemplateId}",
      "params": [
        {
          "name": "exerciseTemplateId",
          "type": "string",
          "location": "path",
          "description": "The id of the exercise template",
          "required": true
        }
      ]
    },
    {
      "name": "exercise-templates_post-v1",
      "description": "Create a new custom exercise template. Required: exercise. Returns the new ExerciseTemplatesPostV1Response.",
      "method": "POST",
      "path": "/v1/exercise_templates",
      "params": [
        {
          "name": "exercise-equipment-category",
          "wire_name": "exercise.equipment_category",
          "type": "string",
          "location": "body",
          "description": "Equipment category"
        },
        {
          "name": "exercise-exercise-type",
          "wire_name": "exercise.exercise_type",
          "type": "string",
          "location": "body",
          "description": "Exercise type"
        },
        {
          "name": "exercise-muscle-group",
          "wire_name": "exercise.muscle_group",
          "type": "string",
          "location": "body",
          "description": "Muscle group"
        },
        {
          "name": "exercise-other-muscles",
          "wire_name": "exercise.other_muscles",
          "type": "string_csv_array",
          "location": "body",
          "description": "The other muscles of the exercise template."
        },
        {
          "name": "exercise-title",
          "wire_name": "exercise.title",
          "type": "string",
          "location": "body",
          "description": "The title of the exercise template."
        }
      ]
    },
    {
      "name": "routine-folders_get-v1",
      "description": "Get a paginated list of routine folders available on the account. Optional: page (default: 1), pageSize (default: 5). Returns array of RoutineFolder.",
      "method": "GET",
      "path": "/v1/routine_folders",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number (Must be 1 or greater)"
        },
        {
          "name": "pageSize",
          "type": "int",
          "location": "query",
          "description": "Number of items on the requested page (Max 10)"
        }
      ]
    },
    {
      "name": "routine-folders_get-v1-folderid",
      "description": "Get a single routine folder by id. Required: folderId. Returns the RoutineFolder.",
      "method": "GET",
      "path": "/v1/routine_folders/{folderId}",
      "params": [
        {
          "name": "folderId",
          "type": "string",
          "location": "path",
          "description": "The id of the routine folder",
          "required": true
        }
      ]
    },
    {
      "name": "routine-folders_post-v1",
      "description": "Create a new routine folder. The folder will be created at index 0, and all other folders will have their indexes incremented. Optional: routine_folder. Returns the new RoutineFolder.",
      "method": "POST",
      "path": "/v1/routine_folders",
      "params": [
        {
          "name": "routine-folder-title",
          "wire_name": "routine_folder.title",
          "type": "string",
          "location": "body",
          "description": "The title of the routine folder."
        }
      ]
    },
    {
      "name": "routines_get-v1",
      "description": "Get a paginated list of routines. Optional: page (default: 1), pageSize (default: 5). Returns array of Routine.",
      "method": "GET",
      "path": "/v1/routines",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number (Must be 1 or greater)"
        },
        {
          "name": "pageSize",
          "type": "int",
          "location": "query",
          "description": "Number of items on the requested page (Max 10)"
        }
      ]
    },
    {
      "name": "routines_get-v1-routineid",
      "description": "Get a routine by its Id. Required: routineId. Returns the RoutinesGetV1RoutineidResponse.",
      "method": "GET",
      "path": "/v1/routines/{routineId}",
      "params": [
        {
          "name": "routineId",
          "type": "string",
          "location": "path",
          "description": "The id of the routine",
          "required": true
        }
      ]
    },
    {
      "name": "routines_post-v1",
      "description": "Create a new routine. Optional: routine. Returns array of RoutinesPostV1Item.",
      "method": "POST",
      "path": "/v1/routines",
      "params": [
        {
          "name": "routine-exercises",
          "wire_name": "routine.exercises",
          "type": "array",
          "location": "body",
          "description": "Exercises"
        },
        {
          "name": "routine-folder-id",
          "wire_name": "routine.folder_id",
          "type": "float",
          "location": "body",
          "description": "The folder id the routine should be added to. Pass null to insert the routine into default 'My Routines' folder"
        },
        {
          "name": "routine-notes",
          "wire_name": "routine.notes",
          "type": "string",
          "location": "body",
          "description": "Additional notes for the routine."
        },
        {
          "name": "routine-title",
          "wire_name": "routine.title",
          "type": "string",
          "location": "body",
          "description": "The title of the routine."
        }
      ]
    },
    {
      "name": "routines_put-v1-routineid",
      "description": "Update an existing routine. Required: routineId. Optional: routine. Returns array of RoutinesPutV1RoutineidItem.",
      "method": "PUT",
      "path": "/v1/routines/{routineId}",
      "params": [
        {
          "name": "routineId",
          "type": "string",
          "location": "path",
          "description": "The id of the routine",
          "required": true
        },
        {
          "name": "routine-exercises",
          "wire_name": "routine.exercises",
          "type": "array",
          "location": "body",
          "description": "Exercises"
        },
        {
          "name": "routine-notes",
          "wire_name": "routine.notes",
          "type": "string",
          "location": "body",
          "description": "Additional notes for the routine."
        },
        {
          "name": "routine-title",
          "wire_name": "routine.title",
          "type": "string",
          "location": "body",
          "description": "The title of the routine."
        }
      ]
