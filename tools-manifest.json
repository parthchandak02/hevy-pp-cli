    {
      "name": "workouts_get-v1",
      "description": "Get a paginated list of workouts. Optional: page (default: 1), pageSize (default: 5). Returns array of Workout.",
      "method": "GET",
      "path": "/v1/workouts",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number (Must be 1 or greater)"
        },
        {
          "name": "pageSize",
          "type": "int",
          "location": "query",
          "description": "Number of items on the requested page (Max 10)"
        }
      ]
    },
    {
      "name": "workouts_get-v1-count",
      "description": "Get the total number of workouts on the account. Returns the WorkoutsGetV1CountResponse.",
      "method": "GET",
      "path": "/v1/workouts/count",
      "params": []
    },
    {
      "name": "workouts_get-v1-events",
      "description": "Retrieve a paged list of workout events (updates or deletes) since a given date. Events are ordered from newest to oldest. The intention is to allow clients to keep their local cache of workouts up to date without having to fetch the entire list of workouts. Optional: page (default: 1), pageSize (default: 5), since (default: 1970-01-01T00:00:00Z). Returns array of WorkoutsGetV1EventsItem.",
      "method": "GET",
      "path": "/v1/workouts/events",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number (Must be 1 or greater)"
        },
        {
          "name": "pageSize",
          "type": "int",
          "location": "query",
          "description": "Number of items on the requested page (Max 10)"
        },
        {
          "name": "since",
          "type": "string",
          "location": "query",
          "description": "Since"
        }
      ]
    },
    {
      "name": "workouts_get-v1-workoutid",
      "description": "Get a single workout’s complete details by the workoutId. Required: workoutId. Returns array of WorkoutsGetV1WorkoutidItem.",
      "method": "GET",
      "path": "/v1/workouts/{workoutId}",
      "params": [
        {
          "name": "workoutId",
          "type": "string",
          "location": "path",
          "description": "The id of the workout",
          "required": true
        }
      ]
    },
